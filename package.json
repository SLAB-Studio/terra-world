{
  "name": "terra-world",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@8.12.1",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=8.12.1"
  },
  "scripts": {
    "dev": "pnpm --filter @terra/web dev",
    "build": "pnpm --filter @terra/web build",
    "start": "pnpm --filter @terra/web start",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/node": "^22.13.10",
    "eslint": "^9.22.0",
    "eslint-config-next": "^15.2.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vitest": "^3.1.1"
  }
}
