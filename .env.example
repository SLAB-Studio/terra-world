# Client-safe values must use the NEXT_PUBLIC_ prefix. Do not add secrets here.
NEXT_PUBLIC_APP_NAME=Terra World

# Server-only 0G integration. Never prefix these values with NEXT_PUBLIC_.
# Testnet and mainnet use different Router endpoints, balances, and API keys.
ZERO_G_NETWORK=testnet
ZERO_G_COMPUTE_API_KEY=
# Choose a currently available TeeML model from the selected Router catalog.
ZERO_G_COMPUTE_MODEL=
ZERO_G_SPONSOR_PRIVATE_KEY=
# Galileo's storage indexer may change; use the current official value.
ZERO_G_STORAGE_INDEXER_URL=

# Optional guarded overrides.
# ZERO_G_CHAIN_RPC_URL=https://evmrpc-testnet.0g.ai
# ZERO_G_COMPUTE_ROUTER_URL=https://router-api-testnet.integratenetwork.work/v1
# ZERO_G_REQUEST_TIMEOUT_MS=12000
# ZERO_G_MAX_RETRIES=2
