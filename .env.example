# Client-safe values must use the NEXT_PUBLIC_ prefix. Do not add secrets here.
NEXT_PUBLIC_APP_NAME=Terra World

# Server-only 0G integration. Never prefix these values with NEXT_PUBLIC_.
# Mainnet is the default. Set testnet explicitly only for Galileo rehearsals.
ZERO_G_NETWORK=mainnet
# false keeps honest authored/local fallbacks; true makes connected 0G routes
# return 503 whenever verified Compute is unavailable.
ZERO_G_REQUIRED=false
ZERO_G_COMPUTE_API_KEY=
# Choose a currently available TeeML model from the selected Router catalog.
ZERO_G_COMPUTE_MODEL=
ZERO_G_SPONSOR_PRIVATE_KEY=

# Adult checkpoint transport: demo locally; zero-g only with server credentials.
TERRA_CHECKPOINT_MODE=demo
TERRA_APP_ORIGIN=http://localhost:3000
# Required when TERRA_CHECKPOINT_MODE=zero-g. Stores opaque session/root metadata;
# encrypted city bytes remain on 0G Storage. Production requires TLS.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/terra_world?sslmode=require
# TERRA_DATABASE_MAX_CONNECTIONS=4

# Public proof values from the verified Rivergate mainnet registration.
ZERO_G_RIVERGATE_STORAGE_ROOT=0x6bec9714b20d3ac73545f3d383de14be75dd267ee5a93b2c31b4f3f48ac96abf
ZERO_G_RIVERGATE_STORAGE_TX_HASH=0x939459398540b3e52bab569d23b22a2e239efc65a47578bcdfdb0580d26a398c
# Optional separate campaign registry; leaving this blank does not invalidate a
# deployed city AgenticID.
ZERO_G_CAMPAIGN_REGISTRY_ADDRESS=
# Verified AgenticID proxy and canonical non-negative decimal agent ID.
ZERO_G_CITY_AGENT_ADDRESS=0x0953a70D8c055799ef55404dE72d1d6c541046a9
ZERO_G_CITY_AGENT_TOKEN_ID=3531123

# Optional guarded overrides.
# ZERO_G_CHAIN_RPC_URL=https://evmrpc.0g.ai
# ZERO_G_COMPUTE_ROUTER_URL=https://router-api.0g.ai/v1
# ZERO_G_STORAGE_INDEXER_URL=https://indexer-storage-turbo.0g.ai
# Finality-aware Storage writes use their own longer deadline (5 minutes).
# ZERO_G_STORAGE_UPLOAD_TIMEOUT_MS=300000
# ZERO_G_REQUEST_TIMEOUT_MS=12000
# ZERO_G_MAX_RETRIES=2
